# Rust
/target
**/*.rs.bk

# Tauri
/src-tauri/target
/src-tauri/gen
/src-tauri/.tauri

# Frontend / tooling
node_modules
dist
.DS_Store
Thumbs.db

# Hidden directories (editor/tool caches, etc.) — never commit dot-dirs
.*/
# 例外：.github 必须入库（CI 与发布流水线）——取反规则要放在忽略规则之后
!/.github/

# Local secrets and runtime data
*.vault
vault.json
.env
.env.*

# Screenshots / scratch
/screenshots
/scratch

# Verification artifacts (fixtures, decoded rasters, logs) — never commit
/out
